<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipamentos Devolvidos</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/alocacoes.css">
</head>
<body>
    <div class="container">
        <h1>Equipamentos Devolvidos</h1>
        <a href="/alocacao" class="back-link">Voltar à Alocação</a>
        <a href="/alocacoes" class="back-link">Ver Alocações Ativas</a>
        <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (hasPrev) { %>
                <a href="/equipamentos-devolvidos?page=<%= currentPage - 1 %>" class="page-link">← Anterior</a>
            <% } %>
            <span>Página <%= currentPage %> de <%= totalPages %></span>
            <% if (hasNext) { %>
                <a href="/equipamentos-devolvidos?page=<%= currentPage + 1 %>" class="page-link">Próxima →</a>
            <% } %>
        </div>
        <% } %>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Professor</th>
                    <th>Sala</th>
                    <th>Projetor</th>
                    <th>Caixa de Som</th>
                    <th>Data</th>
                    <th>Hora</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% entregues.forEach(function(entregue) { %>
                <tr>
                    <td><%= entregue.id %></td>
                    <td><%= entregue.professor %></td>
                    <td><%= entregue.sala %></td>
                    <td><%= entregue.projetor %></td>
                    <td><%= entregue.caixa || 'N/A' %></td>
                    <td><%= entregue.data_alocacao ? new Date(entregue.data_alocacao).toLocaleDateString('pt-BR') : '' %></td>
                    <td><%= entregue.hora_alocacao ? entregue.hora_alocacao.split(':')[0] + 'h' : '' %></td>
                    <td>
                        <form action="/alocacao/<%= entregue.id %>/delete" method="POST" style="display:inline;">
                            <button type="submit" class="delete-btn" onclick="return confirm('Tem certeza que deseja apagar esta alocação?');">Apagar</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% if (!entregues || entregues.length === 0) { %>
        <p>Nenhum equipamento devolvido encontrado.</p>
        <% } %>
    <div class="logo-container">
        <img src="/images/logo.png" alt="Logo">
    </div>
    </div>
</body>
</html>
